# Copy to .env on the server and fill in real values. .env is gitignored.
# Values already present in the process environment take precedence.
# NEVER commit real credentials.

# --- SMTP (password reset + invitation email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CrewBoard" <noreply@example.com>
APP_URL=https://resource.skandstudio.com

# --- WeCom (booking notifications + reminders) ---
# Leave blank to disable WeCom entirely.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_DEPARTMENT_ID=1

# --- Auth watchdog (scripts/auth-watchdog.js) ---
# Without a password the self-check logs SKIPPED and does nothing.
WATCHDOG_URL=http://127.0.0.1:3000
WATCHDOG_ACCOUNT=
WATCHDOG_PASSWORD=
WATCHDOG_ALERT_EMAIL=